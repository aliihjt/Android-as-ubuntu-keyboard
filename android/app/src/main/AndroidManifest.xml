<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+: lets the app find and open the screen viewer apps -->
    <queries>
        <package android:name="com.microsoft.rdc.androidx" />
        <package android:name="ph.spacedesk.beta" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.freerdp.afreerdp" />
        <package android:name="com.gaurav.avnc" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnc" />
        </intent>
        <!-- the tablet's apps, for the home screen -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- speech recognition for Push to Talk -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- reader: translate / dictionary apps, and text-to-speech voices -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Fedora Pad"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- can be the tablet's home screen (Settings › Home screen) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".KeyboardActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".TrackpadActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".MediaActivity" android:exported="false" />
        <activity android:name=".StatsActivity" android:exported="false" />
        <activity android:name=".ControlsActivity" android:exported="false" />
        <activity android:name=".ShortcutsActivity" android:exported="false" />
        <activity android:name=".AppsActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".ClipboardActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FilesActivity" android:exported="false" />
        <activity android:name=".PresenterActivity" android:exported="false" />
        <activity android:name=".ButtonsActivity" android:exported="false" />
        <activity android:name=".WindowsActivity" android:exported="false" />
        <activity android:name=".NotesActivity" android:exported="false" />
        <activity android:name=".PushToTalkActivity" android:exported="false" />
        <activity android:name=".TabletAppsActivity" android:exported="false" />
        <activity android:name=".WebcamActivity" android:exported="false" />
        <activity android:name=".MirrorActivity" android:exported="false" />
        <activity android:name=".ClipHistoryActivity" android:exported="false" />
        <activity android:name=".WakeActivity" android:exported="false" />
        <activity android:name=".ScanActivity" android:exported="false" />
        <activity android:name=".FocusActivity" android:exported="false" />
        <activity android:name=".StandByActivity" android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout" />
        <service
            android:name=".StandByDream"
            android:exported="true"
            android:label="Fedora Pad StandBy"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <activity android:name=".BooksActivity" android:exported="false" />
        <activity android:name=".GetBooksActivity" android:exported="false" />
        <activity android:name=".PoemActivity" android:exported="false" />
        <activity android:name=".HighlightsActivity" android:exported="false" />
        <activity android:name=".VocabActivity" android:exported="false" />
        <activity android:name=".ReaderActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".SketchActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".TerminalActivity" android:exported="false" />
        <activity android:name=".AmbientActivity" android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity android:name=".SpotlightActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the floating keyboard button over the Fedora screen while the tablet is used as a second screen" />
        </service>
        <receiver android:name=".AppUpdate$Done" android:exported="false" />
    </application>
</manifest>
